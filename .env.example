# Steam Web API key — get one at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Random secret for signing session JWTs (generate with: openssl rand -base64 32)
AUTH_SECRET=

# Public base URL of the Rarify SPA and API. No trailing slash.
# Local development with `npm run dev` uses the Vite dev server and proxies
# /api and /auth to the API Worker started by `npm run alchemy:dev`.
PUBLIC_APP_URL=http://localhost:5173

# Hostname served by the Alchemy stack. Omit during local `alchemy dev`;
# set it for previews (preview-rarify.georgejsuarez.com) and production
# (rarify.georgejsuarez.com). The website Worker attaches this custom domain
# and the API Worker attaches /api/* and /auth/* routes on the same host.
# PUBLIC_APP_DOMAIN=rarify.georgejsuarez.com

# Games enriched with live Steam reads per dashboard request (2 Steam
# subrequests each). Cloudflare caps a Worker invocation at 50 subrequests on
# the free plan, so the default fills the library progressively from a D1
# cache. Raise it after upgrading to Workers Paid (1000 subrequests).
ENRICH_BATCH_SIZE=20
