{
  "name": "rarify",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "alchemy:dev": "alchemy dev --env-file .env.local",
    "alchemy:deploy": "alchemy deploy --env-file .env.local",
    "alchemy:plan": "alchemy plan --env-file .env.local",
    "alchemy:destroy": "alchemy destroy --env-file .env.local",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "alchemy:preview": "PUBLIC_APP_DOMAIN=preview-rarify.georgejsuarez.com alchemy deploy --stage preview --env-file .env.local",
    "alchemy:release": "PUBLIC_APP_DOMAIN=rarify.georgejsuarez.com alchemy deploy --stage prod --env-file .env.local"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "4.0.0",
    "jose": "^6.2.3",
    "lucide-react": "^1.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router": "7.16.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261003.1",
    "@effect/platform-node": "4.0.0",
    "@oxlint/plugins": "^1.79.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "24.10.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.1",
    "alchemy": "2.0.0-beta.80",
    "oxfmt": "0.71.0",
    "oxlint": "^1.79.0",
    "shadcn": "^4.13.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "8.3.2",
    "vitest": "^4.1.10"
  }
}
